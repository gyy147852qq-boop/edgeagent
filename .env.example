# 复制为 .env 后填入真实值。.env 不要提交到版本库。
# 大模型密钥（唯一必填项）
LLM_API_KEY=

# 可选：覆盖 config.yaml 中的同名配置
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# ALLOWED_DIRS=D:\AgentWork
# PORT=8765
# 可选：手工固定访问 token（留空则每次启动随机生成并写入 .agent_token）
# AGENT_TOKEN=

# 可选：知识库索引目录（分号或逗号分隔），留空则跟随 ALLOWED_DIRS
# KNOWLEDGE_DIRS=D:\Docs